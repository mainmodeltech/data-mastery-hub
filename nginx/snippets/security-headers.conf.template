# En-têtes de sécurité — à inclure dans le serveur ET dans chaque `location` qui déclare ses propres
# add_header (nginx n'hérite plus des en-têtes du serveur dès qu'un `location` en déclare un).
# Les variables ${CSP_HEADER_NAME}, ${API_ORIGIN} et ${MEDIA_ORIGIN} sont remplacées au démarrage du
# conteneur (modèles nginx) ; les variables nginx ($referrer_policy…) sont laissées telles quelles.

add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy $referrer_policy always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" always;
add_header Strict-Transport-Security "max-age=15552000" always;

# Politique de sécurité de contenu. CSP_HEADER_NAME vaut « Content-Security-Policy-Report-Only » (les
# violations sont seulement signalées dans la console du navigateur) puis « Content-Security-Policy »
# (blocage) une fois une semaine de navigation sans signalement. Sources autorisées : le site, Google
# (reCAPTCHA, Analytics, connexion Google, Maps), Tawk.to (discussion), YouTube/Vimeo (vidéos), l'API
# (API_ORIGIN) et le stockage de fichiers (MEDIA_ORIGIN).
add_header ${CSP_HEADER_NAME} "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://accounts.google.com/gsi/ https://embed.tawk.to https://*.tawk.to; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style https://*.tawk.to; font-src 'self' data: https://fonts.gstatic.com https://*.tawk.to; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' ${API_ORIGIN} ${MEDIA_ORIGIN} https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com/recaptcha/ https://accounts.google.com/gsi/ https://*.tawk.to wss://*.tawk.to; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://www.google.com https://accounts.google.com/gsi/ https://*.tawk.to; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
