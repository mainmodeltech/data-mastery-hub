# Backend Spring Boot (modeltech-backend) — URL du serveur, sans /api/v1 (ajouté par le client HTTP)
VITE_API_BASE_URL=http://localhost:8081

# reCAPTCHA v3 (formulaires publics)
VITE_RECAPTCHA_SITE_KEY=

# Données de démonstration quand un endpoint est absent (dev uniquement, laisser vide en production)
# VITE_ENABLE_DEMO_DATA=true

# ── Staging / production (Docker) ──────────────────────────────────────────────
# Le site est statique : ces variables sont injectees AU BUILD (Dockerfile ARG / compose build.args).
# Les modifier impose de RECONSTRUIRE l'image (un simple redemarrage ne suffit pas).
#   VITE_API_BASE_URL       = https://api-staging.model-technologie.com   (sans /api/v1)
#   VITE_RECAPTCHA_SITE_KEY = cle de site reCAPTCHA v3 autorisee pour le domaine du staging
# Ne jamais activer VITE_ENABLE_DEMO_DATA en staging ni en production.
